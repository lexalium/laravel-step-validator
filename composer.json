{
    "name": "lexal/laravel-step-validator",
    "description": "Laravel Step validator.",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Lex",
            "email": "allapkov@gmail.com"
        }
    ],
    "keywords": [
        "laravel",
        "stepped-form",
        "step validator",
        "multi-form step validator"
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "lexal/stepped-form": "^4.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
        "illuminate/container": "^11.0 || ^12.0",
        "illuminate/http": "^12.0",
        "infection/infection": "^0.30.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5.62",
        "roave/security-advisories": "dev-latest",
        "webimpress/coding-standard": "^1.4"
    },
    "suggest": {
        "illuminate/validation": "Required to use step data validation on Before Handle Step event (^11.0 || ^12.0)."
    },
    "autoload": {
        "psr-4": {
            "Lexal\\LaravelStepValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lexal\\LaravelStepValidator\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lexal\\LaravelStepValidator\\ServiceProvider\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "phpunit": "XDEBUG_MODE=coverage phpunit --coverage-text",
        "phpstan": "phpstan",
        "phpcs": "phpcs",
        "infection": "infection -j4 --only-covered --show-mutations",
        "tests": [
            "@phpcs",
            "@phpstan",
            "@phpunit",
            "@infection"
        ]
    }
}
